              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-Argilla-Api-Key",
              "value": "{{X-Argilla-Api-Key}}",
              "placement": "header"
            }
          },
          "docs": "Delete Suggestion"
        }
      ]
    }
  ],
  "bundled": true
}